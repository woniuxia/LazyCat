{
  "name": "@lazycat/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Lazycat desktop app",
  "author": "Lazycat Team",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build:web": "vite build",
    "build": "pnpm build:web && tauri build --bundles nsis",
    "build:tauri": "tauri build --bundles nsis",
    "build:portable": "pnpm build:web && tauri build --bundles nsis",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@lazycat/formatters": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extensions": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/static-renderer": "^3.22.4",
    "@tiptap/vue-3": "^3.22.4",
    "element-plus": "^2.11.1",
    "frappe-gantt": "^1.2.2",
    "pinyin-pro": "^3.26.0",
    "railroad-diagrams": "^1.0.0",
    "regexp-tree": "^0.1.27",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "monaco-editor": "^0.52.2",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
