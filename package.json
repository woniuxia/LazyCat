{
  "name": "lazycat",
  "version": "0.8.0",
  "private": true,
  "description": "Lazycat - offline developer toolbox desktop app",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10.18.1"
  },
  "scripts": {
    "dev": "pnpm --filter @lazycat/desktop dev",
    "build": "pnpm -r build",
    "build:win:precheck": "powershell -ExecutionPolicy Bypass -File scripts/build-tauri-win.ps1",
    "release:win": "powershell -ExecutionPolicy Bypass -File scripts/release-all-win.ps1",
    "release:all:win": "powershell -ExecutionPolicy Bypass -File scripts/release-all-win.ps1 -AllPackages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @lazycat/desktop test:e2e",
    "build:win": "pnpm --filter @lazycat/desktop build",
    "build:portable": "pnpm --filter @lazycat/desktop build:portable",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-lite-win.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "manuals:sync:mdn-js": "node scripts/scrape-mdn-js.mjs",
    "format": "prettier --write \"**/*.{ts,vue,json,md,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,mjs,cjs}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "prettier": "^3.4.2",
    "puppeteer-core": "25.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "yaml": "2.8.3"
  }
}
